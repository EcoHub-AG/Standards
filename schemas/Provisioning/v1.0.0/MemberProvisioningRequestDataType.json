{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "title": "MemberProvisioningRequestDataType",
    "description": "Member/OrgUnit provisioning request payload (envelope + payload).",
    "type": "object",
    "properties": {
        "operation": {
            "type": "string"
        },
        "action": {
            "type": "string"
        },
        "requestId": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
        },
        "executedBy": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^IDP"
        },
        "requestTime": {
            "type": "string",
            "format": "date-time"
        },
        "payload": {
            "type": "object"
        }
    },
    "required": [
        "operation",
        "action",
        "requestId",
        "executedBy",
        "requestTime",
        "payload"
    ],
    "additionalProperties": false
}