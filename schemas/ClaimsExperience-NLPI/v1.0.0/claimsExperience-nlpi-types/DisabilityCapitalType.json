{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Disability lump sum benefit up to the UVG maximum",
  "type": "object",
  "properties": {
    "insured": {
      "description": "Indicates whether disability lump sum benefit up to the UVG maximum is insured.",
      "type": "boolean"
    },
    "benefitType": {
      "description": "Type of capital benefit amount",
      "type": "string",
      "enum": [
        "salaryMultiple",
        "amount"
      ]
    },
    "benefitValue": {
      "description": "Benefit amount as annual salary multiple (0.5, 1-10) or amount in whole CHF depending on benefitType.",
      "type": "number"
    },
    "progression": {
      "description": "Progression value, if applicable.",
      "type": "integer",
      "enum": [
        100,
        225,
        350
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "insured"
  ],
  "if": {
    "properties": {
      "insured": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "benefitType",
      "benefitValue",
      "progression"
    ]
  }
}
