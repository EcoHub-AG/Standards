{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "description": "Schema for claims information data in the ClaimsExperience NLPI process. This schema is publicly accessible for informational purposes only. Usage requires prior authorization from EcoHub AG.",
  "x-ecohub-license": "© 2025 EcoHub AG. Usage restricted. Prior written authorization required. Swiss law applies. Jurisdiction: Zurich.",
  "properties": {
    "processIdentificationNo": {
      "$ref": "../../../Generics/v1.0.0/ProcessIdentificationNoType.json"
    },
    "timestamp": {
      "$ref": "../../../Generics/v1.0.0/TimestampType.json"
    },
    "processName": {
      "$ref": "../claimsExperience-nlpi-types/ProcessNameConstType.json"
    },
    "subProcessName": {
      "description": "Name of the subprocess",
      "type": "string",
      "const": "claimsExperience"
    },
    "processVersion": {
      "$ref": "../claimsExperience-nlpi-types/ProcessVersionConstType.json"
    },
    "header": {
      "$ref": "../../../Generics/v1.0.0/HeaderType.json"
    },
    "policies": {
      "description": "Claims information grouped by policy.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../claimsExperience-nlpi-types/ClaimInfoPolicyType.json"
      },
      "unevaluatedItems": false
    },
    "comment": {
      "$ref": "../../../Generics/v1.0.0/RestrictedStringType.json",
      "description": "General comment field"
    },
    "contactDetails": {
      "description": "Contact details of the employee at the insurer who is responsible for the request (e.g. backoffice employee).",
      "$ref": "../../../Generics/v1.0.0/ContactType.json"
    },
    "document": {
      "description": "Claims experience documents, typically PDF and CSV.",
      "$ref": "../../../Generics/v1.0.0/MultiFileType.json"
    }
  },
  "additionalProperties": false,
  "required": [
    "processIdentificationNo",
    "timestamp",
    "processName",
    "subProcessName",
    "processVersion",
    "header",
    "policies",
    "contactDetails",
    "document"
  ]
}
