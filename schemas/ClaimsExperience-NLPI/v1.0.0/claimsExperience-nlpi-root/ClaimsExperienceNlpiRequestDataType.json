{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "description": "Schema for a request for claims information in the ClaimsExperience NLPI process. This schema is publicly accessible for informational purposes only. Usage requires prior authorization from EcoHub AG.",
  "x-ecohub-license": "© 2025 EcoHub AG. Usage restricted. Prior written authorization required. Swiss law applies. Jurisdiction: Zurich.",
  "properties": {
    "processIdentificationNo": {
      "$ref": "../../../Generics/v1.0.0/ProcessIdentificationNoType.json"
    },
    "timestamp": {
      "$ref": "../../../Generics/v1.0.0/TimestampType.json"
    },
    "processName": {
      "$ref": "../claimsExperience-nlpi-types/ProcessNameConstType.json"
    },
    "subProcessName": {
      "description": "Name of the subprocess",
      "type": "string",
      "const": "request"
    },
    "processVersion": {
      "$ref": "../claimsExperience-nlpi-types/ProcessVersionConstType.json"
    },
    "header": {
      "$ref": "../../../Generics/v1.0.0/HeaderType.json"
    },
    "previousInsurerCompanyNumber": {
      "$ref": "../claimsExperience-nlpi-types/PreviousInsurerCompanyNumberType.json"
    },
    "subSectorCode": {
      "$ref": "../claimsExperience-nlpi-types/SubSectorCodeType.json"
    },
    "policyNumbers": {
      "description": "Policy numbers for which claims information is requested.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../claimsExperience-nlpi-types/PolicyNumberType.json"
      },
      "unevaluatedItems": false
    },
    "policyholder": {
      "$ref": "../claimsExperience-nlpi-types/PolicyholderType.json"
    },
    "language": {
      "$ref": "../../../Generics/v1.0.0/LanguageType.json"
    },
    "comment": {
      "$ref": "../../../Generics/v1.0.0/RestrictedStringType.json",
      "description": "General comment field"
    },
    "contactDetails": {
      "description": "Contact details of the employee at the broker who is responsible for the request (e.g. backoffice employee).",
      "$ref": "../../../Generics/v1.0.0/ContactType.json"
    },
    "document": {
      "description": "Supporting documents in any file format.",
      "$ref": "../../../Generics/v1.0.0/MultiFileType.json"
    }
  },
  "additionalProperties": false,
  "required": [
    "processIdentificationNo",
    "timestamp",
    "processName",
    "subProcessName",
    "processVersion",
    "header",
    "subSectorCode",
    "policyNumbers",
    "policyholder",
    "language"
  ]
}
