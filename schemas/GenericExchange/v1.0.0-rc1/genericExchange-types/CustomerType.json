{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Customer context for a Generic Exchange event.",
  "type": "object",
  "properties": {
    "customerNumber": {
      "description": "Number of the customer",
      "type": "string"
    },
    "contracts": {
      "description": "Contract or contracts related to the exchange.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "contractNumber": {
            "description": "Contract number related to the exchange.",
            "type": "string"
          },
          "lobIG": {
            "$ref": "../../../Generics/v1.1.0/LOBIGType.json"
          },
          "lobINS": {
            "description": "Branch code insurer. The level of detail should allow receivers to relate the exchange to upstream and downstream processes.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "unevaluatedItems": false
          }
        },
        "additionalProperties": false,
        "required": [
          "contractNumber",
          "lobIG"
        ]
      },
      "unevaluatedItems": false
    },
    "company": {
      "description": "The company the exchange relates to. Either company or person must be specified.",
      "$ref": "../../../Generics/v1.1.0/CompanyMinimalType.json"
    },
    "person": {
      "description": "The person the exchange relates to. Either company or person must be specified.",
      "$ref": "../../../Generics/v1.1.0/PersonMinimalType.json"
    }
  },
  "additionalProperties": false,
  "required": [
  ],
  "oneOf": [
    {
      "required": [
        "company"
      ]
    },
    {
      "required": [
        "person"
      ]
    }
  ]
}
